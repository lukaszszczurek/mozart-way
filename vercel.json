{
  "rewrites": [
    { "source": "/book", "destination": "https://mozartway-calendar.vercel.app/book" },
    { "source": "/book/:path+", "destination": "https://mozartway-calendar.vercel.app/book/:path+" },
    { "source": "/book-call", "destination": "https://mozartway-calendar.vercel.app/book-call" },
    { "source": "/book-call/:path+", "destination": "https://mozartway-calendar.vercel.app/book-call/:path+" },
    { "source": "/r/:code", "destination": "https://mozartway-calendar.vercel.app/r/:code" },
    { "source": "/calendar-assets/:path+", "destination": "https://mozartway-calendar.vercel.app/calendar-assets/:path+" },
    { "source": "/api/booking/:path+", "destination": "https://la-bot-nine.vercel.app/api/booking/:path+" },
    { "source": "/strategia", "destination": "https://mozartway-calendar.vercel.app/strategia" },
    { "source": "/strategia/:path+", "destination": "https://la-bot-nine.vercel.app/strategia/:path+" },
    { "source": "/api/strategia/:path+", "destination": "https://la-bot-nine.vercel.app/api/strategia/:path+" },
    { "source": "/kalkulator", "destination": "https://la-bot-nine.vercel.app/z/kalkulator" },
    { "source": "/z/:path+", "destination": "https://la-bot-nine.vercel.app/z/:path+" },
    { "source": "/api/z/:path+", "destination": "https://la-bot-nine.vercel.app/api/z/:path+" },
    { "source": "/api/o/:path+", "destination": "https://la-bot-nine.vercel.app/api/o/:path+" },
    { "source": "/api/meetings/:id/ics", "destination": "https://la-bot-nine.vercel.app/api/meetings/:id/ics" },
    { "source": "/_next/:path+", "destination": "https://la-bot-nine.vercel.app/_next/:path+" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
